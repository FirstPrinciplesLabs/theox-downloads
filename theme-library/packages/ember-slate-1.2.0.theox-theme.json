{
  "schema_version": "theox.theme-package.v2",
  "key": "theme-package:ember-slate",
  "id": "ember-slate",
  "title": "Ember Slate",
  "summary": "A warm charcoal theme with copper accents, soft paper text, and grounded research-state colors.",
  "details": "Ember Slate trades the usual blue-gray developer palette for warm mineral surfaces and a precise copper accent. The restrained warmth makes manuscripts and long explanations comfortable while preserving crisp borders and visible scientific state changes.",
  "publisher": "FirstPrinciples Labs",
  "version": "1.2.0",
  "license": "MIT",
  "compatibility": {
    "minimum_version": "0.1.2"
  },
  "features": [
    "Warm charcoal surfaces that reduce cold-screen fatigue",
    "Copper navigation accents with soft high-contrast text",
    "Balanced status colors for proofs, warnings, and counterexamples",
    "Warm syntax colors tuned for long writing and review sessions"
  ],
  "tags": [
    "dark",
    "warm",
    "charcoal",
    "writing"
  ],
  "published_at": "2026-10-20",
  "contributes": {
    "workbench": {
      "color_scheme": "dark",
      "colors": {
        "bg": "#171414",
        "sidebar": "#1d1918",
        "surface": "#241f1d",
        "surface-panel": "#211c1b",
        "surface-sunken": "#120f0f",
        "surface-deep": "#181312",
        "surface-raised": "#2a2421",
        "surface-active": "#332a26",
        "surface-hover": "#3a302b",
        "surface-control": "#3d332e",
        "drawer": "#1b1716",
        "titlebar": "#1c1716",
        "statusbar": "#271f1c",
        "border": "#493b35",
        "border-strong": "#6c554b",
        "line-soft": "#332924",
        "line-tree": "#40332e",
        "text": "#f0e8e3",
        "text-soft": "#c9bab0",
        "text-muted": "#9a877c",
        "accent": "#e29a62",
        "blue": "#86a8d8",
        "amber": "#e7bd6d",
        "green": "#8fbe88",
        "rose": "#dc8791",
        "focus": "#ffc18f"
      }
    },
    "syntax": {
